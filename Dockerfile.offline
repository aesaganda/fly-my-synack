# syntax=docker/dockerfile:1
#
# For networks where apt cannot reach Debian mirrors but pip can reach a package
# mirror. It bases on FlyGym's official image purely for the SYSTEM libraries it
# already carries (libEGL, ffmpeg) and ignores that image's own Python
# environment entirely.
#
#   docker build -f Dockerfile.offline -t flysim:cpu \
#     --build-arg PIP_INDEX_URL=https://your-mirror/artifactory/api/pypi/pypi/simple .
#
# If apt works on your network, prefer the main Dockerfile - it is smaller and
# not tied to an amd64-only base image.
#
# Two traps this file exists to document:
#   1. The base image's venv is a uv-managed Python 3.14 whose interpreter lives
#      under /root (mode 700). Moving the venv does not move the interpreter, so
#      it breaks, and `pip` silently resolves to the system 3.12 instead. We
#      therefore build our own venv and install everything into it.
#   2. The base image sets ENTRYPOINT ["/bin/bash"], which turns
#      `docker run <image> python3 run.py` into bash running "python3" as a
#      script. Cleared below.

FROM nelyepfl/flygym:v2.1.0 AS deps
ARG PIP_INDEX_URL=""
# Empty means "use the CPU-only index" - see the note by the pip install.
ARG TORCH_INDEX=""

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN /usr/local/bin/python3.12 -m venv /opt/venv
COPY requirements.txt /tmp/requirements.txt
# torch's own dependencies do not live on TORCH_INDEX, so they must still
# resolve through PIP_INDEX_URL - otherwise pip falls back to
# files.pythonhosted.org, which is the host that is blocked here.
# The CPU-only torch index has to be defaulted HERE and not only on the ARG:
# docker-compose passes `TORCH_INDEX: ${TORCH_INDEX:-}`, and an explicitly empty
# build-arg overrides an ARG default, which turned this into
# `pip install --index-url ""`. Same fix as the main Dockerfile.
ARG TORCH_CPU_INDEX=https://download.pytorch.org/whl/cpu
RUN if [ -n "$PIP_INDEX_URL" ]; then pip config set global.index-url "$PIP_INDEX_URL"; fi \
    && pip install --no-cache-dir --upgrade pip \
    && TORCH_INDEX="${TORCH_INDEX:-$TORCH_CPU_INDEX}" \
    && pip install --no-cache-dir --index-url "$TORCH_INDEX" \
        ${PIP_INDEX_URL:+--extra-index-url "$PIP_INDEX_URL"} torch==2.14.0 \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# ---------------------------------------------------------- data-fetch -----
# Separate stage copying ONLY brain/, so editing run.py or the web UI does not
# invalidate this layer and re-download the connectome tables.
FROM deps AS data-fetch
ARG CONNECTOME_SUBSET=motor
WORKDIR /app
COPY brain/ /app/brain/
RUN mkdir -p /data/connectome \
    && python3 -m brain.fetch --subset "${CONNECTOME_SUBSET}" --out /data/connectome \
       || echo "connectome prefetch skipped; run.py will fetch on demand"

# ------------------------------------------------------------- runtime -----
FROM deps AS runtime
ENV MUJOCO_GL=egl \
    PYOPENGL_PLATFORM=egl \
    FLY_ENV_DIR=/app/environments

RUN useradd --create-home --uid 1000 fly \
    && mkdir -p /data/connectome /data/checkpoints /data/runs \
    && chown -R fly:fly /data

WORKDIR /app
COPY --chown=fly:fly . /app
COPY --from=data-fetch --chown=fly:fly /data/connectome /data/connectome

USER fly
ENTRYPOINT []
CMD ["python3", "run.py", "--list-envs"]
