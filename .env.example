# Copy to `.env` next to docker-compose.yml. Every value is optional.

# --- restricted networks ---------------------------------------------------
# Where apt and public PyPI are blocked but Docker Hub and an internal mirror
# work, build from the offline Dockerfile and point pip at the mirror.
# DOCKERFILE=Dockerfile.offline
# PIP_INDEX_URL=https://your-mirror/artifactory/api/pypi/pypi/simple

# --- GPU -------------------------------------------------------------------
# Also uncomment `gpus: all` under the sim service in docker-compose.yml.
# NOT VERIFIED - see README "Verified vs not".
# BASE_IMAGE=nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04
# TORCH_INDEX=https://download.pytorch.org/whl/cu126
# GPU_DEVICE=0
# TAG=gpu

# --- run configuration -----------------------------------------------------
FLY_ENV=dry_land
STEPS=50000
CONNECTOME=neuprint          # neuprint | feather | synthetic
NEURON_SUBSET=motor          # motor | vnc | all  ('all' needs feather)
RENDER=off
WEB_PORT=8080

# Optional: raises neuPrint rate limits. The default path works without it.
# Never passed to the web service.
# NEUPRINT_TOKEN=
