# Copy to `.env` next to docker-compose.yml. Every value is optional.

# --- restricted networks ---------------------------------------------------
# Where apt and public PyPI are blocked but Docker Hub and an internal mirror
# work, build from the offline Dockerfile and point pip at the mirror.
# DOCKERFILE=Dockerfile.offline
# PIP_INDEX_URL=https://your-mirror/artifactory/api/pypi/pypi/simple

# --- GPU -------------------------------------------------------------------
# Also uncomment `gpus: all` under the sim service in docker-compose.yml.
# NOT VERIFIED - see README "Verified vs not".
# BASE_IMAGE=nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04
# TORCH_INDEX=https://download.pytorch.org/whl/cu126
# GPU_DEVICE=0
# TAG=gpu

# --- run configuration -----------------------------------------------------
FLY_ENV=dry_land
# flat | kitchen | room. The web service defaults to `room` (indoors, where the
# fly flies) and `sim` to `flat`; setting this overrides both. Start-up only -
# swapping worlds means recompiling the MuJoCo model.
# FLY_WORLD=room
# Render size, HEIGHTxWIDTH. Containers have no GPU and rasterise in software,
# so the web service defaults to 264x352 there against 360x480 natively.
# FLY_CAMERA_RES=264x352
# Physics steps per control update. 20 runs the browser demo at real time; 1 is
# the documented model. See README "Real time".
# FLY_CONTROL_EVERY=30
# Seconds of physics per rendered frame. Larger = fewer frames but faster
# playback, because rendering competes with the simulation for the wall clock.
# FLY_FRAME_INTERVAL=0.05
STEPS=50000
CONNECTOME=neuprint          # neuprint | feather | synthetic
NEURON_SUBSET=motor          # motor | vnc | all  ('all' needs feather)
RENDER=off
WEB_PORT=8080

# Optional: raises neuPrint rate limits. The default path works without it.
# Never passed to the web service.
# NEUPRINT_TOKEN=
